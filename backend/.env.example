# Kopiere diese Datei nach ".env" und trage dort deine Werte ein.
# Die ".env" wird nie committet (siehe .gitignore).

# Port, auf dem das Backend läuft
PORT=3000

# Google-Gemini-API-Key aus Google AI Studio (https://aistudio.google.com/apikey).
# Leer lassen = Demo-Modus mit festen Beispieldaten.
GEMINI_API_KEY=

# Optional: anderes Gemini-Modell verwenden.
# Leer lassen = Standardmodell aus src/services/aiService.ts.
GEMINI_MODEL=
